{
  "WatchFolder": "I:\\Pending Processing",
  "MovieDestination": "I:\\Movies",
  "TvDestination": "I:\\TV Shows",
  "ReviewDestination": "I:\\Needs Review",
  "FileBotPath": "filebot",
  "InvocationMode": "ExplicitCli",
  "MoviePresetName": "Organize Movies for Plex",
  "TvPresetName": "Organize Episodes for Plex",
